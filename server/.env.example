# PRIVISION Backend Server Configuration
# Reasoning Provider: 'ollama' (default, local on-device) or 'gemini' (cloud via Google GenAI)
REASONING_PROVIDER=ollama

# Local Ollama Configuration (Default)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct

# Cloud Gemini Configuration (Alternative / Fallback)
# Provide your Google Gemini API key to enable live cloud reasoning.
# The Chrome extension NEVER accesses this key — it remains strictly on this local backend.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Port for reasoning server (defaults to 3721)
PORT=3721

